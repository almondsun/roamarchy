#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_LIMIT=${ROAMARCHY_WORKSPACE_LIMIT:-20}
RUNTIME_DIR=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set in the desktop session}
LOCK_FILE="$RUNTIME_DIR/roamarchy-monitor-layout.lock"

hypr_eval() {
  hyprctl --quiet eval "$1"
}

validate_monitor_name() {
  [[ $1 =~ ^[[:alnum:]_.:-]+$ ]]
}

active_monitors_json() {
  hyprctl monitors -j
}

best_mode_for_monitor() {
  local monitor_name=$1

  hyprctl monitors all -j | jq -r --arg name "$monitor_name" '
    .[]
    | select(.name == $name)
    | .availableModes[]
    | capture("(?<width>[0-9]+)x(?<height>[0-9]+)@(?<refresh>[0-9.]+)Hz")
    | {
        mode: (.width + "x" + .height + "@" + .refresh),
        area: ((.width | tonumber) * (.height | tonumber)),
        refresh: (.refresh | tonumber)
      }
  ' | jq -sr '
    (sort_by(.area, .refresh) | last | .mode) // "preferred"
  '
}

set_workspace_rules() {
  local external=$1
  local internal=$2
  local workspace monitor signature code

  validate_monitor_name "$external"
  validate_monitor_name "$internal"

  signature="split:${external}:${internal}:${WORKSPACE_LIMIT}"
  code='if _G.roamarchy_workspace_rules then for _, rule in ipairs(_G.roamarchy_workspace_rules) do rule:set_enabled(false) end end; _G.roamarchy_workspace_rule_sets = _G.roamarchy_workspace_rule_sets or {}; for _, rule_set in pairs(_G.roamarchy_workspace_rule_sets) do for _, rule in ipairs(rule_set) do rule:set_enabled(false) end end;'
  code+="local signature = \"${signature}\"; local rules = _G.roamarchy_workspace_rule_sets[signature]; if not rules then rules = {};"
  for ((workspace = 1; workspace <= WORKSPACE_LIMIT; workspace++)); do
    if ((workspace % 2 == 1)); then
      monitor=$external
    else
      monitor=$internal
    fi

    code+="table.insert(rules, hl.workspace_rule({ workspace = \"${workspace}\", monitor = \"${monitor}\", persistent = false }));"
  done

  code+=' _G.roamarchy_workspace_rule_sets[signature] = rules; else for _, rule in ipairs(rules) do rule:set_enabled(true) end end; _G.roamarchy_workspace_rules = rules'
  hypr_eval "$code"
}

set_single_monitor_workspace_rules() {
  local internal=$1
  local workspace signature code

  validate_monitor_name "$internal"

  signature="single:${internal}:${WORKSPACE_LIMIT}"
  code='if _G.roamarchy_workspace_rules then for _, rule in ipairs(_G.roamarchy_workspace_rules) do rule:set_enabled(false) end end; _G.roamarchy_workspace_rule_sets = _G.roamarchy_workspace_rule_sets or {}; for _, rule_set in pairs(_G.roamarchy_workspace_rule_sets) do for _, rule in ipairs(rule_set) do rule:set_enabled(false) end end;'
  code+="local signature = \"${signature}\"; local rules = _G.roamarchy_workspace_rule_sets[signature]; if not rules then rules = {};"
  for ((workspace = 1; workspace <= WORKSPACE_LIMIT; workspace++)); do
    code+="table.insert(rules, hl.workspace_rule({ workspace = \"${workspace}\", monitor = \"${internal}\", persistent = false }));"
  done

  code+=' _G.roamarchy_workspace_rule_sets[signature] = rules; else for _, rule in ipairs(rules) do rule:set_enabled(true) end end; _G.roamarchy_workspace_rules = rules'
  hypr_eval "$code"
}

move_existing_workspaces() {
  local external=$1
  local internal=$2
  local workspace current_monitor target_monitor

  while IFS=$'\t' read -r workspace current_monitor; do
    if [[ "$external" == "$internal" ]] || ((workspace % 2 == 0)); then
      target_monitor=$internal
    else
      target_monitor=$external
    fi

    if [[ "$current_monitor" != "$target_monitor" ]]; then
      hypr_eval "hl.dispatch(hl.dsp.focus({ workspace = \"${workspace}\" })); hl.dispatch(hl.dsp.workspace.move({ monitor = \"${target_monitor}\" }))"
    fi
  done < <(
    hyprctl workspaces -j |
      jq -r --argjson limit "$WORKSPACE_LIMIT" '
        .[]
        | select(.id >= 1 and .id <= $limit)
        | [.id, .monitor]
        | @tsv
      '
  )
}

apply_layout_once() {
  local monitors internal external internal_mode external_mode external_width

  monitors=$(active_monitors_json)
  internal=$(jq -r '[.[] | select(.name | test("^eDP")) | .name][0] // empty' <<<"$monitors")

  if [[ -z "$internal" ]]; then
    return 0
  fi

  external=$(
    jq -r --arg internal "$internal" '
      [.[] | select(.name != $internal) | .name][0] // empty
    ' <<<"$monitors"
  )

  if [[ -z "$external" ]]; then
    internal_mode=$(best_mode_for_monitor "$internal")
    validate_monitor_name "$internal"
    hypr_eval "hl.monitor({ output = \"${internal}\", mode = \"${internal_mode}\", position = \"auto\", scale = 1 })"
    set_single_monitor_workspace_rules "$internal"
    move_existing_workspaces "$internal" "$internal"
    hypr_eval 'hl.dispatch(hl.dsp.focus({ workspace = "1" }))'
    return 0
  fi

  internal_mode=$(best_mode_for_monitor "$internal")
  external_mode=$(best_mode_for_monitor "$external")
  external_width=${external_mode%%x*}

  validate_monitor_name "$internal"
  validate_monitor_name "$external"
  hypr_eval "hl.monitor({ output = \"${external}\", mode = \"${external_mode}\", position = \"0x0\", scale = 1 })"
  hypr_eval "hl.monitor({ output = \"${internal}\", mode = \"${internal_mode}\", position = \"${external_width}x0\", scale = 1 })"
  set_workspace_rules "$external" "$internal"
  move_existing_workspaces "$external" "$internal"
  hypr_eval 'hl.dispatch(hl.dsp.focus({ workspace = "1" }))'
}

watch_monitor_events() {
  local socket
  socket="${RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:?HYPRLAND_INSTANCE_SIGNATURE must be set}/.socket2.sock"

  apply_layout_once

  socat -U - "UNIX-CONNECT:${socket}" | while IFS= read -r event; do
    case "$event" in
      monitoradded\>\>*|monitoraddedv2\>\>*|monitorremoved\>\>*|monitorremovedv2\>\>*|configreloaded\>\>*)
        sleep 1
        apply_layout_once
        ;;
    esac
  done
}

main() {
  local command=${1:-apply}

  (
    flock -n 9 || exit 0

    case "$command" in
      apply) apply_layout_once ;;
      watch) watch_monitor_events ;;
      *)
        echo "Usage: $(basename "$0") [apply|watch]" >&2
        exit 2
        ;;
    esac
  ) 9>"$LOCK_FILE"
}

main "$@"
